{
  "name": "@report/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "NextReport Desktop Report Designer (Electron + Next.js)",
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:electron": "tsc -p tsconfig.electron.json && concurrently \"next dev -p 3000\" \"wait-on http://localhost:3000 && electron dist/electron/main.js\"",
    "build": "next build && tsc -p tsconfig.electron.json",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@report/schema": "workspace:*",
    "@report/engine": "workspace:*",
    "@report/react": "workspace:*",
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "wait-on": "^8.0.2"
  }
}
