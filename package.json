{
  "name": "next-report-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise-grade Visual Report Designer Platform & Node.js Reporting Engine",
  "scripts": {
    "build": "pnpm -r --filter=\"./packages/*\" build",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:desktop": "pnpm --filter @report/desktop dev",
    "dev:electron": "pnpm --filter @report/desktop dev:electron",
    "build:desktop": "pnpm --filter @report/desktop build",
    "lint": "eslint packages apps --ext .ts,.tsx"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "packageManager": "pnpm@10.19.0"
}
