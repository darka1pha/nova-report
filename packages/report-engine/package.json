    "@report/core": "workspace:*",
    "@report/exporter": "workspace:*",
    "@report/exporter-pdf": "workspace:*",
    "@report/exporter-docx": "workspace:*",
    "@report/exporter-xlsx": "workspace:*",
    "@report/exporter-html": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
