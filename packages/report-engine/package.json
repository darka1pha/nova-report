{
  "name": "@report/engine",
  "version": "1.0.0",
  "description": "Enterprise-grade Reporting Engine SDK for Node.js, Next.js, and React",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
